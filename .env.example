# Configuration Firebase
# Récupère ces valeurs depuis ta console Firebase :
# https://console.firebase.google.com/ → ton projet → Paramètres du projet → Tes applications → Web
#
# Copie ce fichier en .env et remplace les valeurs ci-dessous par les tiennes.
#
# ⚠️ En Expo, toutes les variables d'environnement exposées au client doivent
#    être préfixées par EXPO_PUBLIC_

EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXX
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=mon-app-hexagone.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=mon-app-hexagone
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=mon-app-hexagone.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456
